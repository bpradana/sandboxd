APP_NAME=sandboxd
APP_ENV=development
LOG_LEVEL=
# Comma-separated bearer API keys; required (>= 16 chars each) in production.
APP_API_KEYS=
APP_BASE_URL=http://localhost:8080
APP_DOCS_ENABLED=true
# Serve the web console (sandbox list, create/kill, browser terminals) at /ui/.
UI_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
# Must exceed SANDBOX_EXEC_MAX_TIMEOUT.
HTTP_WRITE_TIMEOUT=15m
HTTP_STREAM_WRITE_TIMEOUT=30m
HTTP_BODY_LIMIT=4194304

TELEMETRY_ENABLED=false
TELEMETRY_METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_RATIO=1.0

# Engine state and images (keep on ext4/xfs, not overlayfs).
SANDBOX_STATE_DIR=/var/lib/sandboxd
SANDBOX_IMAGES_DIR=/var/lib/sandboxd/images
SANDBOX_DEFAULT_IMAGE=alpine
# Delegated cgroup v2 directory; empty = this process's cgroup (systemd Delegate=yes / private cgroupns).
SANDBOX_CGROUP_ROOT=
SANDBOX_MAX_SANDBOXES=64

# Per-sandbox defaults and maximums callers may request.
SANDBOX_DEFAULT_CPU_MILLIS=1000
SANDBOX_MAX_CPU_MILLIS=4000
SANDBOX_DEFAULT_MEMORY_MB=512
SANDBOX_MAX_MEMORY_MB=4096
# Writable layer: "disk" gives each sandbox its own filesystem in a sparse image
# file under SANDBOX_STATE_DIR (loop-mounted; the image size is the hard limit).
# "tmpfs" keeps it in RAM and adds storage to the memory ceiling.
SANDBOX_STORAGE_DRIVER=disk
# Filesystem inside disk images: ext4 or btrfs; empty picks the first the host
# supports (needs mkfs.ext4 from e2fsprogs or mkfs.btrfs from btrfs-progs).
SANDBOX_STORAGE_FS=
SANDBOX_DEFAULT_STORAGE_MB=512
SANDBOX_MAX_STORAGE_MB=4096
SANDBOX_DEFAULT_PIDS=256
SANDBOX_MAX_PIDS=4096

SANDBOX_DEFAULT_TTL=30m
SANDBOX_MAX_TTL=24h
SANDBOX_IDLE_TIMEOUT=10m
SANDBOX_REAPER_INTERVAL=15s
# How long stopped/failed sandboxes stay visible; 0 purges them on the next reaper pass.
SANDBOX_TOMBSTONE_TTL=10m
SANDBOX_DESTROY_TIMEOUT=10s

# Sandbox uid/gid 0..SIZE-1 map to host BASE..BASE+SIZE-1; commands run as EXEC_UID/GID.
SANDBOX_UID_MAP_BASE=100000
SANDBOX_UID_MAP_SIZE=65536
SANDBOX_EXEC_UID=1000
SANDBOX_EXEC_GID=1000
SANDBOX_SECCOMP_ENABLED=true
# User for commands, sessions, and terminals that name none: root (uid 0 of the
# sandbox's user namespace, unprivileged on the host) or sandbox (EXEC_UID).
SANDBOX_DEFAULT_USER=root

SANDBOX_EXEC_DEFAULT_TIMEOUT=1m
SANDBOX_EXEC_MAX_TIMEOUT=10m
SANDBOX_EXEC_MAX_OUTPUT_BYTES=1048576
SANDBOX_EXEC_MAX_CONCURRENT=8
SANDBOX_EXEC_MAX_SESSIONS=8
# Interactive terminals (PTY over WebSocket) per sandbox.
SANDBOX_EXEC_MAX_TERMINALS=4
# How long a terminal's shell keeps running after its browser disconnects;
# reloading the console within this window reattaches to it.
SANDBOX_TERMINAL_DETACH_TIMEOUT=10m
SANDBOX_FILE_MAX_BYTES=104857600

# Egress networking (bridge + NAT + nftables). Disable to allow only network=none.
SANDBOX_NETWORK_ENABLED=true
SANDBOX_NETWORK_BRIDGE=sbx0
SANDBOX_NETWORK_CIDR=10.88.0.0/16
SANDBOX_NETWORK_DNS=1.1.1.1,8.8.8.8
# Extra CIDRs to block on top of private, link-local, CGNAT, loopback, multicast, and host addresses.
SANDBOX_NETWORK_EGRESS_DENY=
SANDBOX_NETWORK_IP_FORWARD=true

SNAPSHOT_ENABLED=false
SNAPSHOT_S3_BUCKET=
SNAPSHOT_S3_REGION=us-east-1
SNAPSHOT_S3_ENDPOINT=
SNAPSHOT_S3_PREFIX=sandboxd/snapshots
SNAPSHOT_S3_PATH_STYLE=false
SNAPSHOT_TEMP_DIR=/var/lib/sandboxd/snapshot-tmp
SNAPSHOT_TIMEOUT=30m
SNAPSHOT_MAX_BYTES=4294967296
SNAPSHOT_MAX_CONCURRENT=2
SNAPSHOT_SETTINGS_DIR=/var/lib/sandboxd/cloud-storage

# App previews use a separate listener and a unique subdomain per session.
# Docker Compose enables this and publishes host port 18081 for local development.
PREVIEW_ENABLED=false
PREVIEW_ADDRESS=0.0.0.0:8081
PREVIEW_BASE_URL=http://localhost:18081
PREVIEW_TTL=1h
PREVIEW_MAX_SESSIONS=128
